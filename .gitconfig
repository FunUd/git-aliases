[alias]
    # --- 0. ヘルプ機能 (使用タイミング別で表示) ---
    help-aliases = "!git config --get-regexp '^aliasdoc\\.' | awk 'function group_for(name) { if (name == \"help-aliases\") return \"ヘルプ\"; if (name ~ /^(sw|swc|back|rs|unstage|restore-to)$/) return \"切り替え・復元\"; if (name ~ /^(st|sts|cm|ca|fixup|squash|aa|empty)$/) return \"コミット・変更\"; if (name ~ /^(dc|uncommit|diff-w|diff-word|makepatch|reword-at)$/) return \"差分・修正\"; if (name ~ /^(lga|lgn|last|lgs|trace|grep-hist)$/) return \"ログ・履歴\"; if (name ~ /^(br|brv|br-active|bclean|clean-wip|sync-all)$/) return \"ブランチ整理\"; if (name ~ /^(sl|sa|stash-wip|unsh)$/) return \"退避・stash\"; if (name ~ /^(today|largest-files|conflicts|edit-conflicts|hotfiles|head-hash|summary|changelog|ref|tag-today)$/) return \"調査・診断\"; if (name ~ /^(default-branch|up|publish|rebase-default)$/) return \"定番操作\"; return \"未分類\" } function group_order(group) { if (group == \"ヘルプ\") return 0; if (group == \"切り替え・復元\") return 10; if (group == \"コミット・変更\") return 20; if (group == \"差分・修正\") return 30; if (group == \"ログ・履歴\") return 40; if (group == \"ブランチ整理\") return 50; if (group == \"退避・stash\") return 60; if (group == \"調査・診断\") return 70; if (group == \"定番操作\") return 80; return 90 } function item_order(name) { if (name == \"help-aliases\") return 0; if (name == \"sw\") return 10; if (name == \"swc\") return 20; if (name == \"back\") return 30; if (name == \"rs\") return 40; if (name == \"unstage\") return 50; if (name == \"restore-to\") return 60; if (name == \"st\") return 10; if (name == \"aa\") return 20; if (name == \"cm\") return 30; if (name == \"ca\") return 40; if (name == \"fixup\") return 50; if (name == \"squash\") return 60; if (name == \"empty\") return 70; if (name == \"sts\") return 80; if (name == \"dc\") return 10; if (name == \"diff-w\") return 20; if (name == \"diff-word\") return 30; if (name == \"makepatch\") return 40; if (name == \"uncommit\") return 50; if (name == \"reword-at\") return 60; if (name == \"lga\") return 10; if (name == \"lgn\") return 20; if (name == \"last\") return 30; if (name == \"lgs\") return 40; if (name == \"trace\") return 50; if (name == \"grep-hist\") return 60; if (name == \"br\") return 10; if (name == \"brv\") return 20; if (name == \"br-active\") return 30; if (name == \"bclean\") return 40; if (name == \"clean-wip\") return 50; if (name == \"sync-all\") return 60; if (name == \"sl\") return 10; if (name == \"sa\") return 20; if (name == \"stash-wip\") return 30; if (name == \"unsh\") return 40; if (name == \"today\") return 10; if (name == \"head-hash\") return 20; if (name == \"conflicts\") return 30; if (name == \"edit-conflicts\") return 40; if (name == \"largest-files\") return 50; if (name == \"hotfiles\") return 60; if (name == \"summary\") return 70; if (name == \"changelog\") return 80; if (name == \"ref\") return 90; if (name == \"tag-today\") return 100; if (name == \"default-branch\") return 10; if (name == \"up\") return 20; if (name == \"publish\") return 30; if (name == \"rebase-default\") return 40; return 90 } { name = substr($1, 10); value = substr($0, length($1) + 2); split(value, parts, \" / 使い方: \"); desc = parts[1]; usage = parts[2]; group = group_for(name); printf \"%03d\\t%03d\\t%s\\t%s\\t%s\\t%s\\n\", group_order(group), item_order(name), group, name, desc, usage }' | sort -t $'\\t' -k1,1n -k2,2n | awk -F $'\\t' -v OFS=$'\\t' 'BEGIN { print \"コマンド\\t用途\\t使い方\" } { if ($3 != prev) { if (prev != \"\") print \"\"; print \"【\" $3 \"】\"; prev = $3 } print $4, $5, $6 }' | column -t -s $'\\t'"

    # --- 1. switch/restore 系 (モダンGit: 安全な切り替えと復元) ---
    sw = switch                      # 用途: ブランチの切り替え / 使い方: git sw <ブランチ名>
    swc = switch -c                  # 用途: 新規ブランチを作成して即切り替え / 使い方: git swc <新ブランチ名>
    back = switch -                  # 用途: 直前にいたブランチへ戻る / 使い方: git back
    rs = restore                     # 用途: ワークツリーの変更を破棄してファイルをもとに戻す / 使い方: git rs <ファイル名>
    unstage = restore --staged       # 用途: ステージング（add）を取り消す / 使い方: git unstage <ファイル名>
    restore-to = restore --source    # 用途: 指定したコミットの状態までファイルを戻す / 使い方: git restore-to <commit> <ファイル名>

    # --- 2. 基本操作・コミット ---
    st = status -sb                  # 用途: ブランチ名とステータス要約を表示 / 使い方: git st
    sts = !"git status -sb && printf '\\n' && git diff --stat" # 用途: ステータス要約と未ステージ差分の統計を表示 / 使い方: git sts
    cm = commit -m                   # 用途: メッセージ付きでコミット / 使い方: git cm "メッセージ"
    ca = commit --amend --no-edit    # 用途: 直前のコミットに変更を統合 / 使い方: git ca
    fixup = commit --fixup           # 用途: 指定コミットへの fixup を作成 / 使い方: git fixup <commit>
    squash = commit --squash         # 用途: 指定コミットへの squash を作成 / 使い方: git squash <commit>
    aa = add -A                      # 用途: 全変更（追加・更新・削除）をステージング / 使い方: git aa
    empty = commit --allow-empty -m  # 用途: 空コミットを作成（CIトリガー等） / 使い方: git empty

    # --- 3. ログ表示 (視認性向上) ---
    # 用途: 全履歴を1行でグラフ化 / 使い方: git lga
    lga = log --graph --all --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    lgn = !"git lga -n 10"           # 用途: 直近10件のみ表示 / 使い方: git lgn
    last = log -1 --stat --decorate --oneline # 用途: 直近コミットの要約と変更統計を表示 / 使い方: git last
    # 用途: ファイル変更統計（行数）付きでログを表示 / 使い方: git lgs
    lgs = log --graph --stat --name-status --pretty=format:'%C(yellow)commit %h%Creset%C(auto)%d%Creset%nAuthor: %an <%ae>%nDate:   %cd%n%n    %s%n'
    # 用途: 指定ファイルの変更内容を徹底追跡 / 使い方: git trace <ファイル名>
    trace = !sh -c 'git log --follow --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -p -- \"$1\"' -
    # 用途: 変更内容（diff）を検索キーワードで絞り込み / 使い方: git grep-hist <検索語>
    grep-hist = !sh -c 'git log --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -G\"$1\"' -

    # --- 4. クリーンアップ・ブランチ管理 ---
    br = branch                      # 用途: ブランチ一覧表示 / 使い方: git br
    brv = branch -vv                 # 用途: 詳細付きでブランチ一覧表示 / 使い方: git brv
    br-active = branch -vv --sort=-committerdate # 用途: 更新順にブランチ表示 / 使い方: git br-active
    # 用途: マージ済みローカルブランチを安全に一括削除 / 使い方: git bclean
    bclean = !"git fetch -p && git branch --merged | grep -Ev '^(\\*|[[:space:]]*(main|master|develop)$)' | xargs -r git branch -d"
    clean-wip = clean -df            # 用途: 未追跡ファイルを強制削除 / 使い方: git clean-wip
    sync-all = !"git fetch --prune --all && echo 'All remotes pruned and synced.'" # 用途: 全リモート同期 / 使い方: git sync-all

    # --- 5. Stash・退避操作 ---
    sl = stash list                  # 用途: 退避履歴を表示 / 使い方: git sl
    sa = stash apply                 # 用途: 退避した作業を適用 / 使い方: git sa
    stash-wip = stash push --include-untracked -m "wip" # 用途: 未追跡含めて作業を一時退避 / 使い方: git stash-wip
    unsh = stash pop --index         # 用途: ステージング状態を維持して復元 / 使い方: git unsh

    # --- 6. 差分・履歴操作 ---
    dc = diff --cached               # 用途: ステージング済みの差分を確認 / 使い方: git dc
    uncommit = reset --soft HEAD^    # 用途: 直前のコミットを取り消して変更を保持 / 使い方: git uncommit
    diff-w = diff -w --ignore-all-space # 用途: 空白差分を無視 / 使い方: git diff-w
    diff-word = diff --word-diff     # 用途: 単語単位で詳細比較 / 使い方: git diff-word
    makepatch = diff --no-color      # 用途: パッチ生成用 / 使い方: git makepatch > file.patch
    # 用途: 過去のコミットメッセージをリベースなしで修正 / 使い方: git reword-at <hash>
    reword-at = !sh -c 'git commit --allow-empty --fixup=\"$1\" && GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash \"$1\"~1' -

    # --- 7. 特殊分析・調査 ---
    today = !"git log --author=\"$(git config user.name)\" --since=\"midnight\" --no-merges --pretty=format:'%C(yellow)%h%Creset %s (%cr)'" # 用途: 今日の作業 / 使い方: git today
    head-hash = !"git rev-parse HEAD | clip && echo 'Copied HEAD hash to clipboard.'" # 用途: ハッシュをクリップボードにコピー / 使い方: git head-hash
    largest-files = !"git ls-files -z | xargs -0 wc -l | sort -rn | head -n 20" # 用途: 巨大ファイル調査 / 使い方: git largest-files
    conflicts = diff --name-only --diff-filter=U # 用途: コンフリクト中ファイル一覧 / 使い方: git conflicts
    edit-conflicts = !"git conflicts | xargs -r ${VISUAL:-${EDITOR:-code --wait}}" # 用途: コンフリクトファイルを VS Code で開く / 使い方: git edit-conflicts
    hotfiles = !"git log --name-only --since='1 month ago' --pretty=format: | grep -v '^$' | sort | uniq -c | sort -nr | head -n 20" # 用途: 頻繁に触るファイル調査 / 使い方: git hotfiles
    summary = count-objects -vH      # 用途: リポジトリサイズ確認 / 使い方: git summary
    changelog = !"git log $(git describe --tags --abbrev=0)..HEAD --oneline" # 用途: リリース間の更新一覧 / 使い方: git changelog
    ref = reflog --date=relative     # 用途: 全行動履歴の救済表示 / 使い方: git ref
    tag-today = !"git tag release-$(date +'%Y%m%d')" # 用途: 日付で軽量タグ付与 / 使い方: git tag-today

    # --- 8. その他ショートカット ---
    default-branch = !"git switch $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')" # 用途: origin の既定ブランチへ切り替える / 使い方: git default-branch
    up = pull --rebase --autostash   # 用途: 自動stash付きでリベースPull / 使い方: git up
    publish = !"git push -u origin HEAD" # 用途: 現在のブランチを origin に公開 / 使い方: git publish
    rebase-default = !"git fetch origin && git rebase origin/$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') --autostash" # 用途: origin の既定ブランチへ追従してリベース / 使い方: git rebase-default

[aliasdoc]
    help-aliases = alias の一覧と用途を使用タイミングごとに表示 / 使い方: git help-aliases
    sw = ブランチを切り替える / 使い方: git sw <ブランチ名>
    swc = 新規ブランチを作成して即切り替える / 使い方: git swc <新ブランチ名>
    back = 直前にいたブランチへ戻る / 使い方: git back
    rs = ワークツリーの変更を破棄してファイルをもとに戻す / 使い方: git rs <ファイル名>
    unstage = ステージングを取り消す / 使い方: git unstage <ファイル名>
    restore-to = 指定したコミットの状態までファイルを戻す / 使い方: git restore-to <commit> <ファイル名>
    st = ブランチ名とステータス要約を表示 / 使い方: git st
    sts = ステータス要約と未ステージ差分の統計を表示 / 使い方: git sts
    cm = メッセージ付きでコミットする / 使い方: git cm "<メッセージ>"
    ca = 直前のコミットに変更を統合する / 使い方: git ca
    fixup = 指定コミットへの fixup を作成する / 使い方: git fixup <commit>
    squash = 指定コミットへの squash を作成する / 使い方: git squash <commit>
    aa = 全変更をステージングする / 使い方: git aa
    empty = 空コミットを作成する（CIトリガー等） / 使い方: git empty
    lga = 全履歴を1行でグラフ表示する / 使い方: git lga
    lgn = 直近10件のみ表示する / 使い方: git lgn
    last = 直近コミットの要約と変更統計を表示する / 使い方: git last
    lgs = ファイル変更統計付きでログを表示する / 使い方: git lgs
    trace = 指定ファイルの変更内容を徹底追跡する / 使い方: git trace <ファイル名>
    grep-hist = 変更内容を検索キーワードで絞り込む / 使い方: git grep-hist <検索語>
    br = ブランチ一覧を表示する / 使い方: git br
    brv = 詳細付きでブランチ一覧を表示する / 使い方: git brv
    br-active = 更新順にブランチを表示する / 使い方: git br-active
    bclean = マージ済みローカルブランチを安全に一括削除する / 使い方: git bclean
    clean-wip = 未追跡ファイルを強制削除する / 使い方: git clean-wip
    sync-all = 全リモートを prune して同期する / 使い方: git sync-all
    sl = 退避履歴を表示する / 使い方: git sl
    sa = 退避した作業を適用する / 使い方: git sa
    stash-wip = 未追跡を含めて作業を一時退避する / 使い方: git stash-wip
    unsh = ステージング状態を維持して復元する / 使い方: git unsh
    dc = ステージング済みの差分を確認する / 使い方: git dc
    uncommit = 直前のコミットを取り消して変更を保持する / 使い方: git uncommit
    diff-w = 空白差分を無視して比較する / 使い方: git diff-w
    diff-word = 単語単位で詳細比較する / 使い方: git diff-word
    makepatch = パッチ生成用の diff を出す / 使い方: git makepatch > file.patch
    reword-at = 過去のコミットを fixup 経由で修正する / 使い方: git reword-at <hash>
    today = 今日の作業を作者名ベースで表示する / 使い方: git today
    head-hash = HEAD のハッシュをクリップボードへコピーする / 使い方: git head-hash
    largest-files = 巨大ファイルを調べる / 使い方: git largest-files
    conflicts = コンフリクト中のファイル一覧を表示する / 使い方: git conflicts
    edit-conflicts = コンフリクトファイルを VS Code で開く / 使い方: git edit-conflicts
    hotfiles = よく触るファイルを集計する / 使い方: git hotfiles
    summary = リポジトリサイズを確認する / 使い方: git summary
    changelog = リリース間の更新一覧を表示する / 使い方: git changelog
    ref = reflog を相対時刻付きで表示する / 使い方: git ref
    tag-today = 日付付きの軽量タグを作成する / 使い方: git tag-today
    default-branch = origin の既定ブランチへ切り替える / 使い方: git default-branch
    up = rebase 付きで pull する / 使い方: git up
    publish = 現在のブランチを origin に公開する / 使い方: git publish
    rebase-default = origin の既定ブランチへ追従して rebase する / 使い方: git rebase-default

