[alias]
    # --- 0. ヘルプ機能 (二重管理を撤廃した汎用パーサー) ---
    # aliasdoc の内容（ソート順|グループ名|用途/使い方）を動的に解析してグループ化出力します
    ha = "!git config --get-regexp '^aliasdoc\\.' | awk -F'=' '{ \
        name = substr($1, 10); \
        split($2, parts, \"|\"); \
        order = parts[1]; \
        group = parts[2]; \
        split(parts[3], desc, \" / 使い方: \"); \
        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", order, group, name, desc[1], desc[2] \
    }' | sort -t $'\\t' -k1,1n | awk -F $'\\t' -v OFS=$'\\t' 'BEGIN { print \"コマンド\\t用途\\t使い方\" } { \
        if ($2 != prev) { \
            if (prev != \"\") print \"\"; \
            print \"【\" $2 \"】\"; \
            prev = $2 \
        } \
        print $3, $4, $5 \
    }' | column -t -s $'\\t'"

    # --- 1. switch/restore 系 (モダンGit: 安全な切り替えと復元) ---
    sw = switch
    swc = switch -c
    back = switch -
    rs = restore
    unstage = restore --staged
    restore-to = restore --source

    # --- 2. 基本操作・コミット ---
    st = status -sb
    sts = !"git status -sb && printf '\\n' && git diff --stat"
    std = !"git status -sb && printf '\\n--- 変更箇所 (単語単位) ---\\n' && git diff --color-words"
    cm = commit -m
    cma = commit --amend
    ca = commit --amend --no-edit
    fixup = commit --fixup
    squash = commit --squash
    aa = add -A

    # --- 3. ログ表示 (視認性向上) ---
    lg = log --graph --oneline --decorate
    lga = log --graph --all --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    lgn = !"git lga -n 10"
    last = log -1 --stat --decorate --oneline
    lgs = log --graph --stat --name-status --pretty=format:'%C(yellow)commit %h%Creset%C(auto)%d%Creset%nAuthor: %an <%ae>%nDate:   %cd%n%n    %s%n'
    trace = !sh -c 'git log --follow --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -p -- \"$1\"' -
    grep-hist = !sh -c 'git log --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -G\"$1\"' -

    # --- 4. クリーンアップ・ブランチ管理 (デフォルトブランチ動的判定) ---
    br = branch
    brv = branch -vv
    brm = branch -m
    br-active = branch -vv --sort=-committerdate
    bclean = !"default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo 'main'); git fetch -p && git branch --merged | grep -Ev \"^(\\*|[[:space:]]*($default_branch|master|develop)$)\" | while read -r branch; do git branch -d \"$branch\"; done"
    clean-wip = clean -df
    clean-dry = clean -dn
    sync-all = !"git fetch --prune --all && echo 'All remotes pruned and synced.'"

    # --- 5. Worktree 操作 ---
    wt = worktree
    wtl = worktree list
    wtr = worktree remove
    wta = !"sh -c ' \
        if [ -z \"$1\" ]; then \
            echo \"Error: ブランチ名が指定されていません。\"; \
            echo \"使い方: git wta <branch> [<path>]\"; \
            exit 1; \
        fi; \
        branch=$1; \
        custom_path=$2; \
        if ! git rev-parse --verify --quiet \"$branch\" >/dev/null 2>&1; then \
            echo \"Error: 既存のブランチ [$branch] が見つかりません。新規作成する場合は git wtn を使用してください。\"; \
            exit 1; \
        fi; \
        if [ -n \"$custom_path\" ]; then \
            path=\"$custom_path\"; \
        else \
            safe_branch=$(printf \"%s\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"../$safe_branch\"; \
        fi; \
        echo \"既存ブランチ [$branch] を [$path] に展開します...\"; \
        git worktree add \"$path\" \"$branch\"' -"
    wtn = !"sh -c ' \
        if [ -z \"$1\" ]; then \
            echo \"Error: 新規ブランチ名が指定されていません。\"; \
            echo \"使い方: git wtn <new-branch> [<start-point>] [<path>]\"; \
            exit 1; \
        fi; \
        branch=$1; \
        start=$2; \
        custom_path=$3; \
        if [ -z \"$start\" ] || [ -d \"$start\" ]; then \
            custom_path=$start; \
            start=\"\"; \
        fi; \
        if [ -n \"$custom_path\" ]; then \
            path=\"$custom_path\"; \
        else \
            safe_branch=$(printf \"%s\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"../$safe_branch\"; \
        fi; \
        if [ -n \"$start\" ]; then \
            echo \"[$start] から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\" \"$start\"; \
        else \
            echo \"現在の HEAD から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\"; \
        fi' -"

    # --- 6. add -p 補助 ---
    ap = add -p
    ad = !git diff && git add -p
    aps = !git add -p && git status --short
    apc = !git add -p && git commit
    apcm = !git add -p && git commit -m

    # --- 7. Stash・退避操作 ---
    sl = stash list
    sa = stash apply
    sp = stash push -m
    stash-wip = stash push --include-untracked -m "wip"
    unsh = stash pop --index

    # --- 8. 差分・履歴操作 ---
    d = diff
    dc = diff --cached
    uncommit = reset --soft HEAD^
    dw = diff -w --ignore-all-space
    dwo = diff --word-diff
    reword-at = !sh -c 'git commit --allow-empty --fixup=reword:\"$1\" && GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash \"$1\"~1' -

    # --- 9. 特殊分析・調査 (クリップボード差異を吸収) ---
    today = !"git log --author=\"$(git config user.name)\" --since=\"midnight\" --no-merges --pretty=format:'%C(yellow)%h%Creset %s (%cr)'"
    hh = !"git rev-parse HEAD | { command -v clip >/dev/null && clip || command -v pbcopy >/dev/null && pbcopy || command -v xclip >/dev/null && xclip -sel clip; } && echo 'Copied HEAD hash to clipboard.'"
    lf = !"git ls-files -z | xargs -0 wc -l | sort -rn | head -n 20"
    conflicts = diff --name-only --diff-filter=U
    ec = !"files=$(git conflicts); if [ -n \"$files\" ]; then echo \"$files\" | xargs ${VISUAL:-${EDITOR:-code --wait}}; fi"
    hotfiles = !"git log --name-only --since='1 month ago' --pretty=format: | grep -v '^$' | sort | uniq -c | sort -nr | head -n 20"
    changelog = !"git log $(git describe --tags --abbrev=0)..HEAD --oneline"
    ref = reflog --date=relative

    # --- 10. その他ショートカット ---
    db = !"git switch $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
    up = pull --rebase --autostash
    pub = !"git push -u origin HEAD"
    rdb = !"git fetch origin && git rebase origin/$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') --autostash"

[aliasdoc]
    # 記述ルール: <ソート順(2桁)>|<グループ名>|<説明> / 使い方: <使い方>
    # --- ヘルプ ---
    ha = 00|ヘルプ|alias の一覧と用途を使用タイミングごとに表示 / 使い方: git ha

    # --- 切り替え・復元 ---
    sw = 10|切り替え・復元|ブランチを切り替える / 使い方: git sw <ブランチ名>
    swc = 11|切り替え・復元|新規ブランチを作成して即切り替える / 使い方: git swc <新ブランチ名>
    back = 12|切り替え・復元|直前にいたブランチへ戻る / 使い方: git back
    rs = 13|切り替え・復元|ワークツリーの変更を破棄してファイルをもとに戻す / 使い方: git rs <ファイル名>
    unstage = 14|切り替え・復元|ステージングを取り消す / 使い方: git unstage <ファイル名>
    restore-to = 15|切り替え・復元|指定したコミットの内容でファイルを作業ツリーに戻す / 使い方: git restore-to <commit> <ファイル名>

    # --- コミット・変更 ---
    st = 20|コミット・変更|ブランチ名とステータス要約を表示 / 使い方: git st
    aa = 21|コミット・変更|全変更をステージングする / 使い方: git aa
    cm = 22|コミット・変更|メッセージ付きでコミットする / 使い方: git cm "<メッセージ>"
    cma = 23|コミット・変更|直前のコミットメッセージを修正する / 使い方: git cma
    ca = 24|コミット・変更|直前のコミットに変更を統合する / 使い方: git ca
    fixup = 25|コミット・変更|指定コミットへの fixup を作成する / 使い方: git fixup <commit>
    squash = 26|コミット・変更|指定コミットへの squash を作成する / 使い方: git squash <commit>
    ap = 27|コミット・変更|差分を選んでインタラクティブにステージングする / 使い方: git ap
    ad = 28|コミット・変更|差分確認のあとに add -p を開始する / 使い方: git ad
    aps = 29|コミット・変更|add -p のあとにステータスを表示する / 使い方: git aps
    apc = 30|コミット・変更|add -p のあとに commit を開始する / 使い方: git apc
    apcm = 31|コミット・変更|add -p のあとにメッセージ付きでコミットする / 使い方: git apcm \"メッセージ\"
    sts = 32|コミット・変更|ステータス要約と未ステージ差分の統計を表示する / 使い方: git sts
    std = 33|コミット・変更|ステータスと単語単位のコンパクトな差分を表示する / 使い方: git std

    # --- 差分・修正 ---
    d = 40|差分・修正|差分を確認する / 使い方: git d
    dc = 41|差分・修正|ステージング済みの差分を確認する / 使い方: git dc
    dw = 42|差分・修正|空白差分を無視して比較する / 使い方: git dw
    dwo = 43|差分・修正|単語単位で詳細比較する / 使い方: git dwo
    uncommit = 44|差分・修正|直前のコミットを取り消して変更を保持する / 使い方: git uncommit
    reword-at = 45|差分・修正|過去のコミットを fixup 経由で修正する / 使い方: git reword-at <hash>

    # --- ログ・履歴 ---
    lg = 50|ログ・履歴|履歴を簡易グラフ表示する / 使い方: git lg
    lga = 51|ログ・履歴|全履歴を1行でグラフ表示する / 使い方: git lga
    lgn = 52|ログ・履歴|直近10件のみ表示する / 使い方: git lgn
    last = 53|ログ・履歴|直近コミットの要約と変更統計を表示する / 使い方: git last
    lgs = 54|ログ・履歴|ファイル変更統計付きでログを表示する / 使い方: git lgs
    trace = 55|ログ・履歴|指定ファイルの変更内容を徹底追跡する / 使い方: git trace <ファイル名>
    grep-hist = 56|ログ・履歴|コミットの変更差分（diff）の内容から指定キーワードを検索する / 使い方: git grep-hist <検索語>

    # --- ブランチ整理 ---
    br = 60|ブランチ整理|ブランチ一覧を表示する / 使い方: git br
    brv = 61|ブランチ整理|詳細付きでブランチ一覧を表示する / 使い方: git brv
    brm = 62|ブランチ整理|現在のブランチ名を変更する / 使い方: git brm <新しいブランチ名>
    br-active = 63|ブランチ整理|更新順にブランチを表示する / 使い方: git br-active
    bclean = 64|ブランチ整理|マージ済みローカルブランチを安全に一括削除する / 使い方: git bclean
    clean-wip = 65|ブランチ整理|未追跡ファイルを強制削除する / 使い方: git clean-wip
    clean-dry = 66|ブランチ整理|削除される未追跡ファイルを事前に確認する / 使い方: git clean-dry
    sync-all = 67|ブランチ整理|全リモートを prune して同期する / 使い方: git sync-all

    # --- worktree ---
    wt = 70|worktree|worktree サブコマンドの入り口 / 使い方: git wt
    wtl = 71|worktree|worktree の一覧を表示する / 使い方: git wtl
    wta = 72|worktree|既存ブランチを指定パス（省略時は1つ上の階層/ブランチ名）にワークツリーとして展開する / 使い方: git wta <branch> [<path>]
    wtn = 73|worktree|新規ブランチを作成して指定パス（省略時は1つ上の階層/ブランチ名）にワークツリーとして展開する / 使い方: git wtn <new-branch> [<start-point>] [<path>]
    wtr = 74|worktree|worktree を削除する / 使い方: git wtr <path>

    # --- 退避・stash ---
    sl = 80|退避・stash|退避履歴を表示する / 使い方: git sl
    sa = 81|退避・stash|退避した作業を適用する / 使い方: git sa
    sp = 82|退避・stash|メッセージを指定して一時退避する / 使い方: git sp "<メッセージ>"
    stash-wip = 83|退避・stash|未追跡を含めて作業を一時退避する / 使い方: git stash-wip
    unsh = 84|退避・stash|ステージング状態を維持して復元する / 使い方: git unsh

    # --- 調査・診断 ---
    today = 90|調査・診断|今日の作業を作者名ベースで表示する / 使い方: git today
    hh = 91|調査・診断|HEAD のハッシュをクリップボードへコピーする / 使い方: git hh
    lf = 92|調査・診断|巨大ファイルを調べる / 使い方: git lf
    conflicts = 93|調査・診断|コンフリクト中のファイル一覧を表示する / 使い方: git conflicts
    ec = 94|調査・診断|コンフリクトファイルを VS Code で開く / 使い方: git ec
    hotfiles = 95|調査・診断|よく触るファイルを集計する / 使い方: git hotfiles
    changelog = 96|調査・診断|リリース間の更新一覧を表示する / 使い方: git changelog
    ref = 97|調査・診断|reflog を相対時刻付きで表示する / 使い方: git ref

    # --- 定番操作 ---
    db = 100|定番操作|origin の既定ブランチへ切り替える / 使い方: git db
    up = 101|定番操作|rebase 付きで pull する / 使い方: git up
    pub = 102|定番操作|現在のブランチを origin に公開する / 使い方: git pub
    rdb = 103|定番操作|origin の既定ブランチへ追従して rebase する / 使い方: git rdb